# Database (required)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ai_business"

# JWT / token signing (required — use long random strings in production)
ACCESS_TOKEN_SECRET="replace-with-at-least-32-character-secret"
REFRESH_TOKEN_SECRET="replace-with-another-32-character-secret"

# Token lifetimes (jsonwebtoken-compatible, e.g. 15m, 1h, 7d)
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# App URLs / server
FRONTEND_URL="http://localhost:5173"
PORT=5001
NODE_ENV=development

# Redis (BullMQ background jobs)
REDIS_URL="redis://127.0.0.1:6379"

# Python analytics service (dataset cleaning / profiling)
ANALYTICS_SERVICE_URL="http://localhost:8000"

# OpenRouter (RAG answers)
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_MODEL="nex-agi/nex-n2.5-mini:free"

# Refresh token HTTP-only cookie
REFRESH_TOKEN_COOKIE_NAME="refresh_token"
COOKIE_SAME_SITE=lax
COOKIE_PATH=/
# COOKIE_DOMAIN=localhost
# Development: COOKIE_SECURE=false (default when NODE_ENV=development)
# Production: omit COOKIE_SECURE or set COOKIE_SECURE=true (HTTPS required)
